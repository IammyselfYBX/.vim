{
  "coc.preferences.extensionUpdateCheck": "weekly",
  "snippets.ultisnips.directories": [
    "$HOME/.vim/YBXUltiSnips"
  ],
  "snippets.extends": {
    "cuda": ["c", "cpp"]
  },
  "snippets.ultisnips.pythonPrompt": false,
  "clangd.arguments": [
    "--background-index",
    "--clang-tidy",
    "--header-insertion=iwyu",
    "--completion-style=detailed"
  ]
}
